# EsERP — local development environment
# Copy to .env and fill in real values. NEVER commit a real .env.

# --- Database (PostgreSQL 16) ---
# Two roles: `eserp` (owner, used by `docker compose` for migrations/seed)
# and `eserp_app` (least-privilege, used by the API at runtime and by tests).
# RLS policies are bypassed by superusers, so the API must NEVER connect as
# a superuser/owner — always use eserp_app. Create it once with:
#   CREATE USER eserp_app WITH PASSWORD '<app-password>' NOSUPERUSER LOGIN;
#   GRANT CONNECT ON DATABASE eserp TO eserp_app;
#   GRANT USAGE ON SCHEMA public TO eserp_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO eserp_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO eserp_app;
DATABASE_URL="postgresql://eserp_app:<app-password>@localhost:5432/eserp?schema=public"
POSTGRES_USER=eserp
POSTGRES_PASSWORD=eserp_dev_password
POSTGRES_APP_PASSWORD=<app-password>
POSTGRES_DB=eserp

# --- Redis / BullMQ ---
REDIS_URL="redis://localhost:6379"

# --- API (NestJS) ---
API_PORT=3001
API_URL="http://localhost:3001"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Web (Next.js) ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# --- S3-compatible storage (MinIO locally) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION=us-east-1
S3_BUCKET=eserp-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Mail (MailHog locally captures all mail) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="EsERP <noreply@eserp.local>"

# --- OAuth (optional; leave empty to disable) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
OAUTH_CALLBACK_URL="http://localhost:3001/api/v1/auth/oauth/callback"

# --- Observability ---
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
SENTRY_DSN=""

# --- Seed / demo tenant ---
SEED_DEMO_TENANT=true
DEMO_ADMIN_EMAIL=admin@alsafa-trading.sa
DEMO_ADMIN_PASSWORD=Demo1234!

# --- Phase 11 — Integrations ---
# Rate limiting (per tenant + IP; per API key separately). Defaults: 600/min
# per tenant, 300/min per API key, 60s windows.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_SECONDS=60
API_KEY_RATE_LIMIT_MAX=300
API_KEY_RATE_LIMIT_WINDOW_SECONDS=60

# Field encryption (HR national ID / IBAN, AES-256-GCM). Generate with:
#   openssl rand -hex 32
# The API and the seed both read this; the migration script
# (packages/db/prisma/scripts/encrypt-employee-fields.ts) needs the SAME key.
ENCRYPTION_KEY=""

# ZATCA e-invoicing (Saudi Fatoora). Default mode is simulation (no live
# calls). For sandbox calls set mode=sandbox + the compliance CSID/secret
# from ZATCA onboarding; production clearance needs OTP + CCSID + a
# production certificate, which only the tenant can complete.
ZATCA_MODE=simulation
ZATCA_SANDBOX_URL="https://gw-fatoora.zatca.gov.sa/e-invoicing/core"
ZATCA_COMPLIANCE_CSID=""
ZATCA_SECRET=""

# Payment gateways (Saudi). Empty = the mock provider answers (labelled
# simulated, no live charge). Set a key to document a real gateway; wiring
# it needs a real PaymentGateway adapter (see docs/erd-phase11.md).
MOYASAR_API_KEY=""
HYPERPAY_USER_ID=""
HYPERPAY_ENTITY_ID=""
HYPERPAY_ACCESS_TOKEN=""

# SMS provider. Empty = the mock provider logs the message, never sends it.
SMS_API_KEY=""
SMS_SENDER="EsERP"
