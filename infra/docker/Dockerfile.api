# syntax=docker/dockerfile:1
# EsERP API image — multi-stage Node 20 (Alpine).
#
# Stage 1 (build): installs pnpm + the whole workspace's dependencies,
# generates the Prisma client, and compiles @eserp/api (and its workspace
# dependencies @eserp/db and @eserp/shared) to apps/api/dist/.
# Stage 2 (runtime): a slim image that carries the compiled output plus the
# workspace layout the compiled code resolves against. Runs
# `node dist/main.js` from apps/api and exposes port 3001.
#
# Assumptions (see infra/docker/README.md):
# - `pnpm --filter @eserp/api build` emits `apps/api/dist/main.js`.
# - The runtime stage copies the whole workspace node_modules / packages
#   layout rather than a pruned `pnpm deploy`, because @eserp/db and
#   @eserp/shared resolve to their built `dist/` output and the generated
#   Prisma client lives in node_modules/.prisma — pruning risks dropping either.
#
# Build from the repository root:
#   docker build -f infra/docker/Dockerfile.api -t eserp-api .
# (docker-compose.yml already wires this up: `docker compose up -d --build api`.)

FROM node:20-alpine AS build
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

# Copy workspace manifests first so dependency installation is cached
# until a package.json / lockfile changes.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/api/package.json apps/api/
COPY packages/db/package.json packages/db/
COPY packages/shared/package.json packages/shared/
COPY packages/i18n/package.json packages/i18n/
COPY packages/ui/package.json packages/ui/
COPY apps/web/package.json apps/web/

# Install every workspace dependency (dev deps included: the API build
# needs typescript / the Nest CLI), ignoring lifecycle scripts.
RUN pnpm install --frozen-lockfile --ignore-scripts

# Copy sources needed to build the API and its workspace dependencies.
COPY tsconfig.base.json ./
COPY packages/db packages/db
COPY packages/shared packages/shared
COPY packages/i18n packages/i18n
COPY apps/api apps/api

# Prisma client generation + API build.
RUN pnpm --filter @eserp/db generate
RUN pnpm --filter @eserp/api build

FROM node:20-alpine AS runtime
ENV NODE_ENV=production
WORKDIR /app/apps/api

# Non-root user (node image already ships `node` uid 1000).
USER node

# Preserve the workspace layout the compiled output resolves against:
# the built app, the workspace packages (whose `dist/` the compiled code
# `require()`s), and the installed node_modules (including the generated
# Prisma client in node_modules/.prisma).
COPY --from=build --chown=node:node /app/apps /app/apps
COPY --from=build --chown=node:node /app/packages /app/packages
COPY --from=build --chown=node:node /app/node_modules /app/node_modules
COPY --from=build --chown=node:node /app/package.json /app/pnpm-workspace.yaml /app/

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3001/api/v1/health || exit 1

CMD ["node", "dist/main.js"]
